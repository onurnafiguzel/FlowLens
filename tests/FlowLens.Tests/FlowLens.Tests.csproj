<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- Hosts FlowLens.Api in-process. That is not only convenience: an API test that needed a
         real server, or 32 seconds, would mean the "no solution behind a request" rule had been
         broken somewhere. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Synthetic-workspace tests compile snippets that use IEndpointRouteBuilder and MapGroup, so the
    test host needs the ASP.NET Core reference assemblies on its TPA list for SyntheticWorkspace to
    hand them to Roslyn. No ASP.NET Core code is executed.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.test.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlowLens.Core\FlowLens.Core.csproj" />

    <!--
      CliOptions decides which of trace's two modes runs, and getting that wrong sends the user to
      a call chain with no tables in it. Argument parsing is pure and fast to test, so it is tested
      rather than discovered from the console.
    -->
    <ProjectReference Include="..\..\src\FlowLens.Cli\FlowLens.Cli.csproj" />
    <ProjectReference Include="..\..\src\FlowLens.Api\FlowLens.Api.csproj" />
  </ItemGroup>

</Project>